# Password gate. Leave blank for local-only use; REQUIRED before exposing
# this app to any network. Changing it signs out every existing session.
APP_PASSWORD=

# Required for the AI synthesis pass (the deterministic engine runs without it)
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Free key, issued instantly at https://fredaccount.stlouisfed.org/apikeys
# Without it the macro layer falls back to market-based proxies + the US Treasury curve.
FRED_API_KEY=

PORT=5178
